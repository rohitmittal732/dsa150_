class Solution {
    public int longestConsecutive(int[] nums) {
        
        HashSet<Integer> set=new HashSet<>();
        
        if(nums.length==0) return 0;
        int maxLen=1;
        for(int i=0;i<nums.length;i++){
            set.add(nums[i]);
        }

        for(int num:set){
            if(!set.contains(num-1)){
                int len=1;
                int curr=num;

                while(set.contains(curr+1)){
                    len++;
                    curr++;
                }
                maxLen=Math.max(len,maxLen);
            }

        }
        return maxLen;
    }
}
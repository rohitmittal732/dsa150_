class Solution {
    public void moveZeroes(int[] nums) {
       int insertIdx=0;
       int n=nums.length;
       int j=0;

       while(j<n){
        if(nums[j]!=0){
            nums[insertIdx]=nums[j];
            insertIdx++;
        }
        j++;
       }

       while(insertIdx<n){
        nums[insertIdx]=0;
         insertIdx++;

       }
    }
}

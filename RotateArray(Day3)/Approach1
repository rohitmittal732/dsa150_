class Solution {
    public void rotate(int[] nums, int k) {
        Queue<Integer> q=new LinkedList<>();

        int i=0;
        int n=nums.length;

        k=k%n;
        while(i<n){
            q.add(nums[i]);
            i++;
        }

        int j=1;
        while(j<=n-k){
            q.add(q.remove());
            j++;
        }
       
        int idx=0;
        while(  q.size()>0){
          nums[idx]=q.remove();
         idx++;
        }
      
    }
}
class Solution {
    public int smallestIndex(int[] nums) {
        
        int n=nums.length;
      
        for(int i=0;i<nums.length;i++){
              int sum=0;
           while(nums[i]>0){
            sum+= nums[i]%10;
            nums[i]=nums[i]/10;
            n--;
           }
            if(sum==i){
               return i;
            }
            
        }
        return -1;
    }
}
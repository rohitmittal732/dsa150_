class Solution {
    public int subarraySum(int[] nums, int k) {
       
        int i=0;
        int count=0;
        int n=nums.length;
         while(i<n){
            int j=i;
            int sum=0;
            while(j<n){
               sum+=nums[j];

               if(sum==k){
                count+=1;
               }
               j++;
            }
            i++;
         }
         return count;
    }
}
class Solution {
    public boolean isPalindrome(String s) {
        s=s.toLowerCase().replaceAll("[^a-z0-9]","");
        String original="";
      
        for(int i=0;i<s.length();i++){
           
            original+=s.charAt(i);
           
        }
        int i=0;
        int j=original.length()-1;
        
        char[] arr=original.toCharArray();

        while(i<j){
            if(arr[i]!=arr[j]) return false;
            i++;
            j--;
        }
        return true;
    }
}